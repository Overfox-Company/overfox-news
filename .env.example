# Este archivo no contiene credenciales. Copia a .env solo si no existe.
# Producción: usa MongoDB Atlas, con acceso limitado a la base overfox_news.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@TU_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=overfox_news

# Origen exacto (sin ruta); en producción utiliza el dominio público.
APP_URL=https://news.overfox.net
NEXTAUTH_URL=https://news.overfox.net
AUTH_TRUST_HOST=true

# Genera un secreto aleatorio de al menos 32 caracteres. Nunca uses este comentario como secreto.
NEXTAUTH_SECRET=
ADMIN_EMAIL=
# node scripts/generate-admin-hash.mjs
# Formato: scrypt:<salt hexadecimal de 48 caracteres>:<hash hexadecimal de 128 caracteres>
ADMIN_PASSWORD_HASH=

# Token privado de Hugeicons Pro; solo instalación/build. Nunca NEXT_PUBLIC_.
NPM_HUGEICONS_TOKEN=

# Para desarrollo, crea .env.local y sobrescribe estas variables:
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=overfox_news
# APP_URL=http://localhost:3001
# NEXTAUTH_URL=http://localhost:3001
